body {
  margin: 0;
  font-family: Arial, sans-serif;
  text-align: center;
  background: url("https://images.unsplash.com/photo-1504052434569-70ad5836ab65") no-repeat center center fixed;
  background-size: cover;
  color: white;
}

.container {
  margin-top: 120px;
  padding: 20px;
}

h1 {
  font-size: 40px;
}

#verse {
  margin: 20px auto;
  font-size: 20px;
  background: rgba(0,0,0,0.6);
  padding: 15px;
  border-radius: 10px;
  width: 80%;
  max-width: 500px;
}

button {
  padding: 12px 20px;
  font-size: 18px;
  border: none;
  border-radius: 8px;
  cursor: pointer;
}